# PRIVATE — copy to .env.deploy and fill in. Never commit. Never paste in chat.
#
#   cp .env.deploy.example .env.deploy
#   open .env.deploy   # then edit

# --- Server login (same VPS as SyncCode) ---
SSH_HOST=YOUR_SERVER_IP
SSH_USER=YOUR_SERVER_USERNAME
SSH_PORT=22

# Optional: only for first manual login from your Mac.
# GitHub Actions cannot use a password — use an SSH key (see below).
# SSH_PASSWORD=YOUR_SERVER_PASSWORD

SSH_PATH=/opt/apps/hotel
DOMAIN=hotel.synccode.co.zw

# After you can SSH in, create a deploy key and point to it here:
SSH_PRIVATE_KEY_FILE=~/.ssh/synccode_deploy

ACME_EMAIL=admin@synccode.co.zw
ADMIN_EMAIL=admin@hotel.synccode.co.zw
ADMIN_PASSWORD=
